{
  "name": "bunvite",
  "version": "1.0.0",
  "description": "Blazing-fast zero-dependency Vite alternative powered purely by Bun.",
  "license": "MIT",
  "author": "Nicat Bayramov",
  "keywords": [
    "bun",
    "vite",
    "typescript",
    "tailwindcss",
    "starter",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BayramovNicat/bunvite.git"
  },
  "homepage": "https://github.com/BayramovNicat/bunvite#readme",
  "scripts": {
    "dev": "bun --watch run vite.ts dev",
    "build": "bun run vite.ts build",
    "preview": "bun run vite.ts preview",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "format": "bunx biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "type": "module"
}
